# ============================================================================
# AI/LLM Configuration
# ============================================================================

# AI Framework: Provider Selection (openai, gemini, anthropic, custom_openai, openrouter)
SELECTED_PROVIDER=openai

# ----------------------------------------------------------------------------
# OpenAI Provider
# ----------------------------------------------------------------------------
# OpenAI API key for AI framework (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Smart model: use a reasoning model (gpt-5.2)
# Fast model: use a quick, cost-efficient model (gpt-5-mini)
OPENAI_SMART_MODEL=gpt-5.2
OPENAI_FAST_MODEL=gpt-5-mini

# ----------------------------------------------------------------------------
# Google Gemini Provider
# ----------------------------------------------------------------------------
# Google Gemini API key for AI features (get from: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=google-ai-studio-api-key-here
# Smart model: use a reasoning model (gemini-3-pro)
# Fast model: use a quick, cost-efficient model (gemini-3-flash)
GEMINI_SMART_MODEL=gemini-3-pro
GEMINI_FAST_MODEL=gemini-3-flash

# ----------------------------------------------------------------------------
# Anthropic Provider
# ----------------------------------------------------------------------------
# Anthropic API key for Claude models (get from: https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# Smart model: use a reasoning model (claude-opus-4.5, claude-sonnet-4.5)
# Fast model: use a quick, cost-efficient model (claude-haiku-4.5)
ANTHROPIC_SMART_MODEL=claude-sonnet-4.5
ANTHROPIC_FAST_MODEL=claude-haiku-4.5

# ----------------------------------------------------------------------------
# Custom OpenAI-Compatible Provider
# ----------------------------------------------------------------------------
# For generic OpenAI-compatible endpoints (LocalAI, LM Studio, vLLM, etc.)
# Note: For OpenRouter, prefer using the dedicated 'openrouter' provider below
CUSTOM_OPENAI_BASE_URL=https://api.example.com/v1
CUSTOM_OPENAI_API_KEY=sk-your-custom-api-key-here
# Custom OpenAI-compatible smart/fast model names
CUSTOM_OPENAI_SMART_MODEL=your-smart-model
CUSTOM_OPENAI_FAST_MODEL=your-fast-model

# ----------------------------------------------------------------------------
# OpenRouter Provider (recommended for OpenRouter)
# ----------------------------------------------------------------------------
# Native OpenRouter support with automatic model profile detection.
# Properly handles provider-specific features like Gemini's thought signatures.
# Get API key from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here
# Smart model: use a reasoning model (z-ai/glm-4.6, qwen/qwen3-235b-a22b-2507)
# Fast model: use a quick model (z-ai/glm-4.5-air, qwen/qwen3-next-80b-a3b-instruct)
OPENROUTER_SMART_MODEL=z-ai/glm-4.6
OPENROUTER_FAST_MODEL=z-ai/glm-4.5-air

# ============================================================================
# Backend Services Configuration
# ============================================================================

# Backend server configuration
BACKEND_PORT=8000
UVICORN_HOST=0.0.0.0

# Docling service configuration (document conversion)
DOCLING_HOST=docling-serve
DOCLING_PORT=5001

# Logging configuration
LOG_LEVEL=INFO

# ============================================================================
# Frontend Configuration
# ============================================================================

FRONTEND_PORT=3000
# Backend URL accessible from the browser (use localhost for local development)
BACKEND_SERVICE_URL=http://localhost:8000

# ============================================================================
# Database Configuration
# ============================================================================

POSTGRES_USER=rekwai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rekwai
POSTGRES_PORT=5432

# ============================================================================
# Object Storage Configuration (S3/Garage)
# ============================================================================

# S3 Configuration
# Internal service name for docker-compose (use 'localhost' for local dev)
S3_URL=garage
S3_PORT=3900
# S3_REGION MUST match value from garage/garage.toml configuration
S3_REGION=ca-central-1

# Garage configuration
GARAGE_API_PORT=3900
GARAGE_ADMIN_PORT=3903
INITIAL_BUCKET_NAME=upload-documents

# Below are secrets & tokens required for Garage. There is a script (garage/generate-tokens-and-secrets.sh) to generate them
# GARAGE_RPC_SECRET must be 32-byte hex-encoded random string (openssl rand -hex 32)
GARAGE_RPC_SECRET=xxx
# GARAGE_METRICS_TOKEN must be a random token (openssl rand -base64 32)
GARAGE_METRICS_TOKEN=yyy
# GARAGE_ADMIN_TOKEN must be a random token (openssl rand -base64 32)
GARAGE_ADMIN_TOKEN=zzz
# Garage Key ID MUST starte with GK followed by 24 character hex-encoded random string (openssl rand -hex 12)
S3_ACCESS_KEY_ID=GK1234567890abcdef12345678
# Garage Secret Access Key must be 32-byte hex-encoded random string (openssl rand -hex 32)
S3_SECRET_ACCESS_KEY=changeme123456

# ============================================================================
# Testing and Development Configuration
# ============================================================================

# Playwright E2E Testing
PLAYWRIGHT_BASE_URL=http://frontend:3000

# Logfire configuration (get write token from: https://logfire.pydantic.dev/)
ENABLE_LOGFIRE=false
LOGFIRE_TOKEN=
